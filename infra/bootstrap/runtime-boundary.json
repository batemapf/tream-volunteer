{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/tream-*",
        "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/tream-*/index/*"
      ]
    },
    {
      "Sid": "ApplicationQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:us-east-2:ACCOUNT_ID:tream-*"
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/tream-*:*"
    },
    {
      "Sid": "SendVerifiedEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:ACCOUNT_ID:identity/*",
        "arn:aws:ses:us-east-2:ACCOUNT_ID:configuration-set/tream-*"
      ]
    },
    {
      "Sid": "InvokeApplicationFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:tream-*"
    },
    {
      "Sid": "PublishApplicationMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Tream"
        }
      }
    }
  ]
}
